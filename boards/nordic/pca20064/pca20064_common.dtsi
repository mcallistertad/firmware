#include <mem.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include <dt-bindings/regulator/npm1300.h>
#include <dt-bindings/regulator/npm6001.h>

/ {
	model = "Nordic Thingy:91 X PCA20064 nRF9161 prototype";
	compatible = "nordic,pca20064-nrf9161";

	chosen {
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,uart-mcumgr = &uart0;
		nordic,pm-ext-flash = &flash_ext;
		zephyr,wifi = &nordic_wlan0;
	};

	buttons {
		compatible = "gpio-keys";
		button0: button_0 {
			gpios = <&gpio0 26 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Button 1";
		};
	};

	leds {
		compatible = "gpio-leds";
		red_led: led_0 {
			gpios = <&gpio0 29 GPIO_ACTIVE_HIGH>;
			label = "RGB red channel";
		};
		green_led: led_1 {
			gpios = <&gpio0 31 GPIO_ACTIVE_HIGH>;
			label = "RGB green channel";
		};
		blue_led: led_2 {
			gpios = <&gpio0 30 GPIO_ACTIVE_HIGH>;
			label = "RGB blue channel";
		};
	};

	pwmleds {
		compatible = "pwm-leds";
		pwm_red: pwm_led_0 {
			pwms = <&pwm0 0 PWM_MSEC(8) PWM_POLARITY_NORMAL>;
		};
		pwm_green: pwm_led_1 {
			pwms = <&pwm0 1 PWM_MSEC(8) PWM_POLARITY_NORMAL>;
		};
		pwm_blue: pwm_led_2 {
			pwms = <&pwm0 2 PWM_MSEC(8) PWM_POLARITY_NORMAL>;
		};
	};

	zephyr,user {
		nrf5340-reset-gpios = <&gpio0 20 GPIO_ACTIVE_LOW>;
	};

	aliases {
		sw0 = &button0;
		led0 = &red_led;
		led1 = &green_led;
		led2 = &blue_led;
		pwm-led0 = &pwm_red;
		pwm-led1 = &pwm_green;
		pwm-led2 = &pwm_blue;
		rgb-pwm = &pwm0;
		mcuboot-button0 = &button0;
		spi-flash0 = &flash_ext;
	};
};

&adc {
	status = "okay";
};

&gpiote {
	status = "okay";
};

&gpio0 {
	status = "okay";
	sense-edge-mask = <0xffffffff>;
};

&pwm0 {
	status = "okay";
	pinctrl-0 = <&pwm0_default>;
	pinctrl-1 = <&pwm0_sleep>;
	pinctrl-names = "default", "sleep";
};

/* The nRF91 system clock driver uses an RTC timer instance. B0 also uses
 * Zephyr timeout helpers, so leaving all timer nodes disabled produces an
 * unresolved sys_clock_elapsed symbol at link time.
 */
&timer0 {
	status = "okay";
};

&timer1 {
	status = "okay";
};

&timer2 {
	status = "okay";
};

&uart0 {
	compatible = "nordic,nrf-uarte";
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart0_default>;
	pinctrl-1 = <&uart0_sleep>;
	pinctrl-names = "default", "sleep";
};

&uart1 {
	compatible = "nordic,nrf-uarte";
	status = "okay";
	current-speed = <1000000>;
	pinctrl-0 = <&uart1_default>;
	pinctrl-1 = <&uart1_sleep>;
	pinctrl-names = "default", "sleep";
};

/ {
	zephyr,user {
		rf-fe-enable-gpios = <&gpios_pmic 1
			(GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN | GPIO_PULL_UP)>;
	};
};

&i2c2 {
	compatible = "nordic,nrf-twim";
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	pinctrl-0 = <&i2c2_default>;
	pinctrl-1 = <&i2c2_sleep>;
	pinctrl-names = "default", "sleep";

	bme680: bme680@76 {
		compatible = "bosch,bme680";
		status = "disabled";
		reg = <0x76>;
	};

	pmic_main: npm1300@6b {
		compatible = "nordic,npm1300";
		status = "disabled";
		pmic-int-pin = <3>;
		reg = <0x6b>;

		gpios_pmic: npm1300_gpios {
			compatible = "nordic,npm1300-gpio";
			status = "disabled";
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <5>;
		};

		npm1300_regulators: regulators {
			compatible = "nordic,npm1300-regulator";
			status = "disabled";

			reg_3v3: BUCK2 {
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				enable-gpios = <&gpios_pmic 2 GPIO_ACTIVE_HIGH>;
			};

			ldsw_npm6001_en: LDO1 {
				regulator-initial-mode = <NPM1300_LDSW_MODE_LDSW>;
				regulator-allowed-modes = <NPM1300_LDSW_MODE_LDSW>;
				regulator-boot-off;
				startup-delay-us = <2000>;
				off-on-delay-us = <2000>;
			};

			ldsw_sensors: LDO2 {
				regulator-initial-mode = <NPM1300_LDSW_MODE_LDSW>;
				regulator-allowed-modes = <NPM1300_LDSW_MODE_LDSW>;
				regulator-boot-on;
			};
		};

		/* Charging is opt-in. These values are for the confirmed LP803448
		 * 1S 3.7 V, 1350 mAh pack: 4.20 V termination, 0.2C standard
		 * charging, and a 10 kOhm B3435 NTC over the 0-45 C charge range.
		 * Do not enable this node for an unknown replacement battery.
		 */
		npm1300_charger: charger {
			compatible = "nordic,npm1300-charger";
			status = "disabled";
			vbus-limit-microamp = <500000>;
			term-microvolt = <4200000>;
			current-microamp = <270000>;
			dischg-limit-microamp = <1000000>;
			thermistor-cold-millidegrees = <0>;
			thermistor-cool-millidegrees = <0>;
			thermistor-warm-millidegrees = <45000>;
			thermistor-hot-millidegrees = <45000>;
			thermistor-ohms = <10000>;
			thermistor-beta = <3435>;
		};
	};

	pmic_wifi: npm6001@70 {
		compatible = "nordic,npm6001";
		status = "disabled";
		reg = <0x70>;

		regulators {
			compatible = "nordic,npm6001-regulator";
			status = "disabled";
			pmic_wifi_buck0: BUCK0 { regulator-boot-off; };
			pmic_wifi_buck1: BUCK1 { regulator-boot-off; };
			pmic_wifi_buck2: BUCK2 { regulator-boot-off; };

			reg_wifi: BUCK3 {
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-initial-mode = <NPM6001_MODE_HYS>;
				regulator-boot-on;
			};
		};
	};

	accelerometer_lp: adxl367@1d {
		compatible = "adi,adxl367";
		status = "disabled";
		odr = <3>;
		reg = <0x1d>;
	};

	magnetometer: bmm350@14 {
		compatible = "bosch,bmm350";
		status = "disabled";
		reg = <0x14>;
	};
};

&spi3 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	pinctrl-0 = <&spi3_default>;
	pinctrl-1 = <&spi3_sleep>;
	pinctrl-names = "default", "sleep";
	cs-gpios = <&gpio0 12 GPIO_ACTIVE_LOW>,
		   <&gpio0 17 GPIO_ACTIVE_LOW>;

	flash_ext: gd25lb256e@0 {
		compatible = "jedec,spi-nor";
		status = "okay";
		reg = <0>;
		spi-max-frequency = <8000000>;
		jedec-id = [c8 67 19];
		size = <268435456>;
		has-dpd;
		t-enter-dpd = <3000>;
		t-exit-dpd = <30000>;
	};

	nrf70: wifi@1 {
		compatible = "nordic,nrf7002-spi";
		status = "disabled";
		reg = <1>;
		spi-max-frequency = <DT_FREQ_M(8)>;
		iovdd-ctrl-gpios = <&gpio0 27 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
		bucken-gpios = <&gpio0 28 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
		host-irq-gpios = <&gpio0 16 GPIO_ACTIVE_HIGH>;

		nordic_wlan0: wlan0 {
			compatible = "nordic,wlan";
		};

		wifi-max-tx-pwr-2g-dsss = <21>;
		wifi-max-tx-pwr-2g-mcs0 = <16>;
		wifi-max-tx-pwr-2g-mcs7 = <16>;
		wifi-max-tx-pwr-5g-low-mcs0 = <9>;
		wifi-max-tx-pwr-5g-low-mcs7 = <9>;
		wifi-max-tx-pwr-5g-mid-mcs0 = <11>;
		wifi-max-tx-pwr-5g-mid-mcs7 = <11>;
		wifi-max-tx-pwr-5g-high-mcs0 = <13>;
		wifi-max-tx-pwr-5g-high-mcs7 = <13>;
	};
};

/* These fixed partitions provide valid DTS chosen nodes. Partition Manager
 * replaces them with pca20064_nrf9161_pm_static.yml in sysbuild.
 */
&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0 {
			label = "mcuboot";
			reg = <0x00000000 0x10000>;
		};
		slot0_partition: partition@10000 {
			label = "image-0";
			reg = <0x00010000 0x30000>;
		};
		slot0_ns_partition: partition@40000 {
			label = "image-0-nonsecure";
			reg = <0x00040000 0x40000>;
		};
		slot1_partition: partition@80000 {
			label = "image-1";
			reg = <0x00080000 0x30000>;
		};
		slot1_ns_partition: partition@b0000 {
			label = "image-1-nonsecure";
			reg = <0x000b0000 0x40000>;
		};
		scratch_partition: partition@f0000 {
			label = "image-scratch";
			reg = <0x000f0000 0xa000>;
		};
		storage_partition: partition@fa000 {
			label = "storage";
			reg = <0x000fa000 0x00006000>;
		};
	};
};

/ {
	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		sram0_s: image_s@20000000 {
			reg = <0x20000000 DT_SIZE_K(64)>;
		};
		sram0_bsd: image_bsd@20010000 {
			reg = <0x20010000 DT_SIZE_K(64)>;
		};
		sram0_ns: image_ns@20020000 {
			reg = <0x20020000 DT_SIZE_K(128)>;
		};
	};
};
